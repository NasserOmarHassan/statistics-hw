const $ = s => document.querySelector(s);
const TEST = 'test test test test test test test test test test test junk';
const hex = Core.hex;
let current = null;

// Keccak-256 versus SHA3-256 for the word "abc"
(() => {
  const m = Core.enc.encode('abc');
  $('#hcmp').innerHTML = `Keccak-256("abc")<br>${hex(Core.keccak256(m))}<br>SHA3-256("abc")<br>${hex(Core.sha3_256(m))}`;
})();

// Compute the whole pipeline for a mnemonic and a path
async function derive() {
  const ps = Core.parseMnemonic($('#mn').value);
  if (!ps.ok) { $('#mnstatus').innerHTML = `<span class="bad">${ps.err}</span>`; return; }
  $('#mnstatus').innerHTML = `<span class="ok">Valid BIP-39 phrase (${ps.words.length} words, checksum OK)</span>`;
  let w;
  try { w = await Core.wallet(ps.phrase, '', $('#path').value.trim()); } catch (e) { $('#mnstatus').innerHTML = `<span class="bad">${e.message}</span>`; return; }
  current = w;
  const pub = Core.pubUncompressed(w.Q), digest = Core.keccak256(pub.slice(1)), raw = hex(w.raw);
  const addr = [...w.address.slice(2)].map(c => /[A-F]/.test(c) ? `<b>${c}</b>` : c).join('');
  const row = (a, b, c) => `<tr><td>${a}</td><td>${b}</td><td class="out">${c}</td></tr>`;
  $('#pipe').innerHTML =
    row('1. Seed', 'BIP-39: PBKDF2-HMAC-SHA512, 2048 rounds', hex(w.seed)) +
    row('2. Master key', 'BIP-32: HMAC-SHA512 with "Bitcoin seed"', 'key: ' + hex(Core.toBytes(w.levels[0].key, 32)) + '<br>chain code: ' + hex(w.levels[0].chain)) +
    row('3. Private key', 'BIP-44 path ' + $('#path').value.trim(), '0x' + hex(Core.toBytes(w.priv, 32))) +
    row('4. Public key', 'secp256k1: Q = k·G', 'x: ' + hex(Core.toBytes(w.Q[0], 32)) + '<br>y: ' + hex(Core.toBytes(w.Q[1], 32))) +
    row('5. Hash', 'Keccak-256 of the 64 bytes x ‖ y', hex(digest)) +
    row('6. Raw address', 'last 20 bytes of the hash', '0x' + raw) +
    row('7. Final address', 'EIP-55 checksum (capitals in bold)', '0x' + addr);
  $('#statout').innerHTML = '';
}
$('#bder').onclick = derive;
$('#btest').onclick = () => { $('#mn').value = TEST; $('#path').value = "m/44'/60'/0'/0/0"; derive(); };
$('#bgen').onclick = () => { // 128 random bits -> 12 words
  const e = crypto.getRandomValues(new Uint8Array(16));
  $('#mn').value = Core.entropyToMnemonic(e).words.join(' '); derive();
};

// Avalanche experiment: flip each of the first 64 bits of the public key and compare Keccak-256 digests
const pop = n => { let c = 0; while (n) { c += n & 1; n >>= 1; } return c; };
const ham = (a, b) => a.reduce((s, v, i) => s + pop(v ^ b[i]), 0);
$('#bstat').onclick = () => {
  if (!current) { $('#statout').textContent = 'Derive a wallet first.'; return; }
  const m = Core.cat(Core.toBytes(current.Q[0], 32), Core.toBytes(current.Q[1], 32)), d0 = Core.keccak256(m);
  const full = [], suffix = []; let onesCount = 0, totalBits = 0;
  for (let b = 0; b < 64; b++) {
    const m2 = m.slice(); m2[b >> 3] ^= 1 << (b & 7);
    const d1 = Core.keccak256(m2);
    full.push(ham(d0, d1)); suffix.push(ham(d0.slice(12), d1.slice(12)));
    d1.forEach(v => onesCount += pop(v)); totalBits += 256;
  }
  const mean = a => a.reduce((s, v) => s + v, 0) / a.length;
  const f = onesCount / totalBits, entropy = -f * Math.log2(f) - (1 - f) * Math.log2(1 - f);
  const bins = new Array(8).fill(0); full.forEach(d => bins[Math.max(0, Math.min(7, Math.floor((d - 96) / 8)))]++);
  const mx = Math.max(...bins, 1), labels = ['below 104', '104-111', '112-119', '120-127', '128-135', '136-143', '144-151', '152 and up'];
  $('#statout').innerHTML = `
  <div class="scroll"><table><thead><tr><th>Measurement</th><th>Result</th><th>Expected</th></tr></thead><tbody>
  <tr><td>Average bits changed in the 256-bit digest</td><td>${mean(full).toFixed(2)}</td><td>about 128</td></tr>
  <tr><td>Average bits changed in the 160-bit address part</td><td>${mean(suffix).toFixed(2)}</td><td>about 80</td></tr>
  <tr><td>Share of 1 bits in the modified digests</td><td>${(f * 100).toFixed(2)}%</td><td>about 50%</td></tr>
  <tr><td>Binary entropy per bit</td><td>${entropy.toFixed(4)}</td><td>at most 1</td></tr>
  </tbody></table></div>
  <p>Histogram of bits changed in the 64 trials:</p>` +
  bins.map((v, i) => `<div class="bar"><span class="n">${labels[i]}</span><i style="width:${v / mx * 60}%"></i><span>${v}</span></div>`).join('') +
  `<p style="margin-top:10px">The results are close to the expected values, so the hash behaves as the avalanche effect predicts. The test is only descriptive. The 64 inputs are related to each other, the modified input is usually not a valid public key, and the entropy figure only measures how balanced the 0 and 1 bits are. It says nothing about the entropy of a private key. A small experiment like this cannot prove that the hash is secure.</p>`;
};
$('#mn').value = TEST; derive();
