  const RC = (() => { const out = []; let L = 1; for (let t = 0; t < 24; t++) { let rc = 0n; for (let j = 0; j < 7; j++) { const bit = L & 1; L = (L & 0x80) ? ((L << 1) ^ 0x71) & 255 : (L << 1) & 255; if (bit) rc ^= 1n << BigInt((1 << j) - 1); } out.push(rc); } return out; })();
