<script>
(() => {
'use strict';
const $ = (s, r = document) => r.querySelector(s);
const mod = (a, p) => { const r = a % p; return r >= 0n ? r : r + p; };
function inv(a, p) {
  let r0 = mod(a, p), r1 = p, s0 = 1n, s1 = 0n;
  while (r1 !== 0n) { const q = r0 / r1; [r0, r1] = [r1, r0 - q * r1]; [s0, s1] = [s1, s0 - q * s1]; }
  return mod(s0, p);
}
const bitlen = n => { let c = 0; n = BigInt(n); while (n > 0n) { c++; n >>= 1n; } return c; };
const pop = n => { let c = 0; while (n > 0) { c += n & 1; n = Math.floor(n / 2); } return c; };

function makeCurve(p, a, b) {
  const on = P => P === null || mod(P[1] * P[1] - (P[0] ** 3n + a * P[0] + b), p) === 0n;
  const neg = P => P === null ? null : [P[0], mod(-P[1], p)];
  function add(P, Q, info) {
    if (P === null) return Q; if (Q === null) return P;
    const [x1, y1] = P, [x2, y2] = Q;
    if (x1 === x2 && mod(y1 + y2, p) === 0n) { if (info) info.type = 'inf'; return null; }
    let m, type;
    if (x1 === x2) { m = mod((3n * x1 * x1 + a) * inv(2n * y1, p), p); type = 'double'; }
    else { m = mod((y2 - y1) * inv(x2 - x1, p), p); type = 'add'; }
    const x3 = mod(m * m - x1 - x2, p), y3 = mod(m * (x1 - x3) - y1, p);
    if (info) { info.type = type; info.m = m; }
    return [x3, y3];
  }
  function mul(k, P) { // left-to-right double-and-add
    if (k === 0n || P === null) return null;
    const bits = k.toString(2); let R = P;
    for (let i = 1; i < bits.length; i++) { R = add(R, R); if (bits[i] === '1') R = add(R, P); }
    return R;
  }
  return { p, a, b, on, neg, add, mul };
}

/* ---------- Keccak-256 (control hash, same primitive Ethereum uses) ---------- */
