/* ---------- self test ---------- */
function selfTest() {
  const ok = [];
  ok.push(hex(keccak256(new Uint8Array())) === 'c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470' && hex(keccak256(new TextEncoder().encode('abc'))) === '4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45');
  const g2 = SC.mul(2n, SG), g3 = SC.mul(3n, SG);
  ok.push(h64(g2[0]) === 'c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee5');
  ok.push(h64(g3[0]) === 'f9308a019258c31049344f85f89d5229b531c845836f99b08601f113bce036f9');
  ok.push(SC.mul(SN, SG) === null && SC.on(SG));
  const C17 = makeCurve(17n, 0n, 7n), Q = C17.mul(6n, [1n, 5n]), R6 = (() => { let R = null; for (let i = 0; i < 6; i++) R = C17.add(R, [1n, 5n]); return R; })();
  ok.push(C17.on(Q) && fmt(Q) === fmt(R6));
  const b = $('#selftest'); const all = ok.every(Boolean);
  b.textContent = all ? 'Self-test passed: Keccak-256 vectors, secp256k1 2G, 3G and n·G = O, toy 6G by both methods' : 'Self-test FAILED: ' + ok.map(Boolean).join(',');
